# ── 語音辨識（STT）────────────────────────────────────────────
# 到 https://console.deepgram.com 註冊，新帳號送 US$200 額度
# 不填也能跑，操作頁會自動退回瀏覽器 Web Speech 備援模式
DEEPGRAM_API_KEY=

# 講者口音：英國腔用 en-GB，美國腔用 en-US
STT_LANGUAGE=en-GB
STT_MODEL=nova-3

# ── 翻譯 ────────────────────────────────────────────────────
# 二選一即可。兩個都填時，用 TRANSLATE_PROVIDER 決定；沒指定就挑第一個有 key 的。
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# TRANSLATE_PROVIDER=gemini        # gemini | claude
# TRANSLATE_MODEL=gemini-3.7-flash # 不填則用該服務商預設

# ── 場次設定 ────────────────────────────────────────────────
# 不填會在啟動時隨機產生並印在畫面上。7 天活動建議固定下來，網址才不會每天變。
# ROOM_CODE=SHOW
# OPERATOR_KEY=changeme123

# PORT=8787
